{
  "name": "discord-invite-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "backup": "tsx src/scripts/backup.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
